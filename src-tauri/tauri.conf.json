{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoTether",
  "version": "0.7.0",
  "identifier": "com.repotether.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:11420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RepoTether",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lancard-aikawa",
    "copyright": "Copyright (c) 2026 lancard-aikawa",
    "shortDescription": "ローカルの git・Claude Code のセッション・リモートの一覧をまとめて見る",
    "longDescription": "ローカルの git リポジトリ、Claude Code のセッション、GitHub / Gogs / Gitea のリポジトリ一覧をまとめて、いつ何をやったか・どこに時間を使っているか・いま何が取り残されているかを見る個人用のデスクトップアプリ",
    "category": "DeveloperTool",
    "homepage": "https://github.com/lancard-aikawa/RepoTether",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  }
}
